package templates

type CreateUserForm struct {
	Email string
	Error string
}

templ CreateUserPage() {
	@AuthCard("Create user") {
		@CreateUser(CreateUserForm{})
		<p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
			Have an account?
			<a class="font-medium text-blue-600 hover:underline dark:text-blue-400" href="/login">Log in</a>
		</p>
	}
}

// CreateUser renders the form. htmx posts it to /users and swaps this element
// with the response, so the form re-renders with errors or is replaced by the
// success fragment. The wrapping id must match hx-target for the swap to land.
templ CreateUser(form CreateUserForm) {
	<form id="create-user" class="flex flex-col gap-4" hx-post="/users" hx-target="#create-user" hx-swap="outerHTML">
		@csrfField()
		if form.Error != "" {
			<p role="alert" class="rounded-md bg-red-50 px-3 py-2 text-sm text-red-700 dark:bg-red-950 dark:text-red-300">{ form.Error }</p>
		}
		<label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 dark:text-gray-300">
			Email
			<input class="input" type="email" name="email" value={ form.Email } required/>
		</label>
		<label class="flex flex-col gap-1.5 text-sm font-medium text-gray-700 dark:text-gray-300">
			Password
			<input class="input" type="password" name="password" minlength="12" required/>
		</label>
		<button class="btn-primary mt-2 w-full" type="submit">Create</button>
	</form>
}
