package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="preload" href="/static/fonts/inter-variable.woff2" as="font" type="font/woff2" crossorigin/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			// theme.js must stay render-blocking and ahead of the body: it sets the
			// dark class on <html>, and deferring it would flash the light theme.
			<script src="/static/js/theme.js"></script>
			<script src="/static/htmx.min.js"></script>
		</head>
		<body class="bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
			{ children... }
		</body>
	</html>
}

// AppShell is the shared shell for signed-in pages: the header bar plus a
// centered content column. Pages render their own heading and body as children.
templ AppShell(title string, email string) {
	@Layout(title) {
		@header(email)
		<main class="mx-auto max-w-4xl p-8">
			{ children... }
		</main>
	}
}

// header is the signed-in navigation bar. Logout posts as a form so it carries
// the CSRF token; the handler replies with HX-Redirect to send the browser to
// /login, which is why nothing needs swapping in.
templ header(email string) {
	<header class="border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900">
		<div class="mx-auto flex max-w-4xl items-center justify-between gap-4 p-4">
			<div class="flex items-center gap-6">
				<a class="text-lg font-semibold text-gray-900 dark:text-white" href="/dashboard">Flashcard</a>
				<nav class="flex items-center gap-4 text-sm font-medium text-gray-700 dark:text-gray-300">
					<a class="hover:text-gray-900 dark:hover:text-white" href="/dashboard">Dashboard</a>
					<a class="hover:text-gray-900 dark:hover:text-white" href="/decks">Decks</a>
				</nav>
			</div>
			<div class="flex items-center gap-4">
				<span class="hidden text-sm text-gray-500 sm:inline dark:text-gray-400">{ email }</span>
				@themeToggle()
				<form hx-post="/logout" hx-swap="none">
					@csrfField()
					<button class="btn-primary" type="submit">Log out</button>
				</form>
			</div>
		</div>
	</header>
}

// themeToggle flips the theme client-side — no request, no session state, so it
// works on the signed-out pages too. Both icons are always in the markup and CSS
// picks one, which keeps the button correct without any JS touching its label.
templ themeToggle() {
	<button
		type="button"
		onclick="toggleTheme()"
		title="Toggle dark mode"
		aria-label="Toggle dark mode"
		class="rounded-md border border-gray-200 px-2 py-1.5 text-sm text-gray-600 transition-colors hover:bg-gray-50 hover:text-gray-900 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800 dark:hover:text-white"
	>
		<span class="dark:hidden" aria-hidden="true">&#9789;</span>
		<span class="hidden dark:inline" aria-hidden="true">&#9788;</span>
	</button>
}

// AuthCard is the shared shell for the login and registration pages: a centered
// card with a heading. Both pages render their form (and any footer links) as
// children so the card markup lives in one place.
templ AuthCard(title string) {
	@Layout(title) {
		<main class="flex min-h-screen items-center justify-center bg-gray-50 p-4 dark:bg-gray-950">
			<div class="w-full max-w-sm rounded-lg border border-gray-200 bg-white p-8 shadow-sm dark:border-gray-800 dark:bg-gray-900">
				<h1 class="mb-6 text-2xl font-semibold text-gray-900 dark:text-white">{ title }</h1>
				{ children... }
			</div>
		</main>
	}
}
